{
  "name": "shades-of-pink-theme-extension",
  "version": "0.1.0",
  "description": "A Gemini CLI extension providing a delightful 'shades-of-pink' theme.",
  "themes": [
    {
      "name": "shades-of-pink-theme",
      "type": "custom",
      "background": {
        "primary": "#ffe4e1"
      },
      "text": {
        "primary": "#c22d6e",
        "secondary": "#a25a77",
        "link": "#ff69b4"
      },
      "status": {
        "success": "#d8bfd8",
        "warning": "#ffb6c1",
        "error": "#ff6347"
      },
      "border": {
        "default": "#ffc0cb"
      },
      "ui": {
        "comment": "#ffafbd"
      }
    }
  ]
}